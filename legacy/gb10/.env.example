# Public hostname. Create its A record at Hostinger before enabling Caddy TLS.
API_DOMAIN=api.example.com

# Keep this secret outside Git. Generate, for example: openssl rand -hex 32
VLLM_API_KEY=replace-with-a-long-random-secret

# Default full-precision vLLM checkpoint. The Vast GB10 has 119 GB VRAM.
MODEL_ID=nasmtrcs/Qwen3.8-27B-OBLITERATED
SERVED_MODEL_NAME=qwen-abliterated
VLLM_IMAGE=vllm/vllm-openai:latest
HF_HOME=/opt/qwen-abliterated-api/model-cache
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=8

# vLLM options chosen for Qwen reasoning/tool calls. Set to false only to debug.
ENABLE_REASONING=true
ENABLE_TOOL_CALLING=true

